<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Ejada Test Suite" verbose="1">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="Utils.ExtentReportListener"/>
    </listeners>

    <test name="APITest" preserve-order="true">
        <classes>
            <class name="EndPoints.Status"/>
            <class name="EndPoints.ListOfBooks"/>
            <class name="EndPoints.GetASingleBook"/>
            <class name="EndPoints.GetToken"/>
            <class name="EndPoints.SubmitAnOrder"/>
            <class name="EndPoints.GetAllOrders"/>
            <class name="EndPoints.GetAnOrder"/>
            <class name="EndPoints.UpdateAnOrder"/>
            <class name="EndPoints.DeleteAnOrder"/>
        </classes>
    </test>

</suite>